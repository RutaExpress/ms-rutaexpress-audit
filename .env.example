# Puerto de la aplicación
PORT=8087

# Configuración de Base de Datos (Oracle): AUDIT_USER lo crea rutaexpress-infra/apps/oracle/01-usuarios.sh
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@//localhost:1521/ORCLPDB1
SPRING_DATASOURCE_USERNAME=AUDIT_USER
# secreto: el valor real va solo en el .env (no se sube)
SPRING_DATASOURCE_PASSWORD=

# Configuración de Kafka (los 3 brokers de rutaexpress-infra/kafka)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092,localhost:9093,localhost:9094
